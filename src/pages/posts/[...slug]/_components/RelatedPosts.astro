---
import type { RelatedPost } from "@/utils/getRelatedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  posts: RelatedPost[];
};

const { posts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

{posts.length > 0 && (
  <nav data-pagefind-ignore aria-label={t.post.relatedPosts} class="my-8">
    <h2 class="text-lg font-semibold tracking-wide">{t.post.relatedPosts}</h2>
    <ul class="mt-4 flex flex-col gap-2">
      {posts.map(post => (
        <li>
          <a
            href={getPostUrl(post.id, post.filePath, locale)}
            class="text-accent/85 underline decoration-dashed underline-offset-4 hover:opacity-75"
          >
            {post.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
