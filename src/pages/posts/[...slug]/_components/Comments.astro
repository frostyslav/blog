---
import config from "@/config";

const { giscus } = config;
---

{
  giscus && (
    <section
      id="comments"
      class="mt-4"
      aria-label="Comments"
      data-giscus-repo={giscus.repo}
      data-giscus-repo-id={giscus.repoId}
      data-giscus-category={giscus.category}
      data-giscus-category-id={giscus.categoryId}
      data-giscus-mapping={giscus.mapping}
      data-giscus-reactions-enabled={giscus.reactionsEnabled ? "1" : "0"}
      data-giscus-emit-metadata={giscus.emitMetadata ? "1" : "0"}
      data-giscus-input-position={giscus.inputPosition}
      data-giscus-loading={giscus.loading}
      data-giscus-lang={giscus.lang}
    />
  )
}

<script>
  const GISCUS_ORIGIN = "https://giscus.app";

  // Read the site's current theme ("light" or "dark") from the root element.
  function currentTheme() {
    return document.documentElement.getAttribute("data-theme") === "dark"
      ? "dark"
      : "light";
  }

  // Send a theme change to an already-loaded Giscus iframe.
  function sendThemeToGiscus(theme: string) {
    const iframe = document.querySelector<HTMLIFrameElement>(
      "iframe.giscus-frame"
    );
    iframe?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme } } },
      GISCUS_ORIGIN
    );
  }

  // Inject the Giscus client script into the #comments container.
  function mountGiscus() {
    const container = document.getElementById("comments");
    if (!container || container.querySelector("script")) return;

    const ds = container.dataset;
    if (!ds.giscusRepo || !ds.giscusRepoId || !ds.giscusCategoryId) return;

    const script = document.createElement("script");
    script.src = `${GISCUS_ORIGIN}/client.js`;
    script.async = true;
    script.crossOrigin = "anonymous";
    script.setAttribute("data-repo", ds.giscusRepo);
    script.setAttribute("data-repo-id", ds.giscusRepoId);
    script.setAttribute("data-category", ds.giscusCategory ?? "");
    script.setAttribute("data-category-id", ds.giscusCategoryId);
    script.setAttribute("data-mapping", ds.giscusMapping ?? "pathname");
    script.setAttribute("data-strict", "0");
    script.setAttribute(
      "data-reactions-enabled",
      ds.giscusReactionsEnabled ?? "1"
    );
    script.setAttribute("data-emit-metadata", ds.giscusEmitMetadata ?? "0");
    script.setAttribute(
      "data-input-position",
      ds.giscusInputPosition ?? "bottom"
    );
    script.setAttribute("data-theme", currentTheme());
    script.setAttribute("data-lang", ds.giscusLang ?? "en");
    script.setAttribute("data-loading", ds.giscusLoading ?? "lazy");
    container.appendChild(script);
  }

  // Keep Giscus in sync when the site theme toggles. The source of truth is the
  // data-theme attribute on the root element, so observe it directly — this
  // covers the #theme-btn click, OS preference changes, and View Transitions.
  let themeObserver: MutationObserver | undefined;
  function watchTheme() {
    themeObserver?.disconnect();
    themeObserver = new MutationObserver(() =>
      sendThemeToGiscus(currentTheme())
    );
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }

  function init() {
    mountGiscus();
    watchTheme();
  }

  init();

  // Re-run after View Transitions navigation, since the container is replaced
  // with a fresh (script-less) node on each page swap.
  document.addEventListener("astro:after-swap", init);
</script>
